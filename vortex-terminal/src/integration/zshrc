# Runs the user's own .zshrc, see .zshenv, then installs the hooks that emit OSC 133 markers:
#   C: a command starts running      D;status: it finished      A: the prompt starts
#   B: the prompt ends, the command is typed
# and OSC 7 (the working directory) at each prompt; binds two keys only Vortex sends, one that
# reports the command line being edited (OSC 6973, its bytes in hexadecimal) and one that clears
# it, to edit the command in a Vortex buffer.
if [[ -n ${VORTEX_USER_ZDOTDIR+x} ]]; then ZDOTDIR=$VORTEX_USER_ZDOTDIR; else unset ZDOTDIR; fi
if [[ -r ${ZDOTDIR:-$HOME}/.zshrc ]]; then source "${ZDOTDIR:-$HOME}/.zshrc"; fi
if [[ -n ${ZDOTDIR+x} ]]; then VORTEX_USER_ZDOTDIR=$ZDOTDIR; else unset VORTEX_USER_ZDOTDIR; fi
ZDOTDIR=$VORTEX_ZDOTDIR

__vx_precmd() {
    local __vx_status=$?
    local __vx_cwd=${PWD//\%/%25}
    printf '\e]133;D;%s\a\e]7;file://%s%s\a\e]133;A\a' "$__vx_status" "$HOST" "${__vx_cwd// /%20}"
    return "$__vx_status"
}
__vx_report_line() {
    printf '\e]6973;%s\a' "$(print -rn -- "$BUFFER" | od -An -tx1 | tr -d ' \n')"
}
zle -N __vx_report_line
for __vx_map in emacs viins vicmd; do
    bindkey -M $__vx_map '\e[5556~' __vx_report_line
    bindkey -M $__vx_map '\e[5557~' kill-buffer
done
unset __vx_map
__vx_preexec() {
    printf '\e]133;C\a'
}
# Last: the prompt ends with B, where the user types the command (after the right prompt, which
# zsh draws after the left one). Again when a theme set the prompt anew.
__vx_prompt_end() {
    if [[ -n $RPS1 ]]; then
        [[ $RPS1 == *'133;B'* ]] || RPS1="$RPS1%{"$'\e]133;B\a'"%}"
    else
        [[ $PS1 == *'133;B'* ]] || PS1="$PS1%{"$'\e]133;B\a'"%}"
    fi
}
autoload -Uz add-zsh-hook
add-zsh-hook preexec __vx_preexec
add-zsh-hook precmd __vx_prompt_end
# First, to see the exit status of the command.
add-zsh-hook precmd __vx_precmd
precmd_functions=(__vx_precmd ${precmd_functions:#__vx_precmd})

# Done: give ZDOTDIR back to the user, unless .zlogin still has to be read.
if [[ ! -o login ]]; then
    if [[ -n ${VORTEX_USER_ZDOTDIR+x} ]]; then ZDOTDIR=$VORTEX_USER_ZDOTDIR; else unset ZDOTDIR; fi
    unset VORTEX_USER_ZDOTDIR VORTEX_ZDOTDIR
fi
