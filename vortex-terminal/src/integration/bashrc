# Shell integration for Vortex's terminal panel. Started with `bash --init-file`, which replaces
# ~/.bashrc only (bash still reads /etc/bash.bashrc itself). Emits OSC 133 markers:
#   C: a command starts running      D;status: it finished      A: the prompt starts
#   B: the prompt ends, the command is typed
# and OSC 7 (the working directory) at each prompt; binds two keys only Vortex sends, one that
# reports the command line being edited (OSC 6973, its bytes in hexadecimal) and one that clears
# it, to edit the command in a Vortex buffer.

if [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi

if [ -z "$__vx_integration_loaded" ]; then
    __vx_integration_loaded=1

    # Runs first in PROMPT_COMMAND, to see the exit status of the command, and gives the same
    # status back to whatever runs next.
    __vx_precmd() {
        local __vx_status=$?
        __vx_at_prompt=
        local __vx_cwd=${PWD//%/%25}
        printf '\e]133;D;%s\a\e]7;file://%s%s\a\e]133;A\a' "$__vx_status" "$HOSTNAME" "${__vx_cwd// /%20}"
        return "$__vx_status"
    }

    __vx_report_line() {
        printf '\e]6973;%s\a' "$(printf %s "$READLINE_LINE" | od -An -tx1 | tr -d ' \n')"
    }
    for __vx_map in emacs vi-insert vi-command; do
        bind -m "$__vx_map" -x '"\e[5556~": __vx_report_line'
        bind -m "$__vx_map" '"\e[5557~": kill-whole-line'
    done
    unset __vx_map

    # Runs last in PROMPT_COMMAND: from here on, the DEBUG trap (old bash) is for the command.
    # The prompt ends with B, where the user types the command; again if PROMPT_COMMAND set PS1.
    __vx_arm() {
        local __vx_status=$?
        [[ $PS1 == *'133;B'* ]] || PS1="${PS1}"'\[\e]133;B\a\]'
        __vx_at_prompt=1
        return "$__vx_status"
    }

    if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" == "declare -a"* ]]; then
        PROMPT_COMMAND=(__vx_precmd "${PROMPT_COMMAND[@]}" __vx_arm)
    elif [ -n "$PROMPT_COMMAND" ]; then
        PROMPT_COMMAND="__vx_precmd;${PROMPT_COMMAND%;};__vx_arm"
    else
        PROMPT_COMMAND="__vx_precmd;__vx_arm"
    fi

    if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4))); then
        # PS0 is printed after the line is read, before the command runs.
        PS0="${PS0}"'\e]133;C\a'
    else
        __vx_preexec() {
            local __vx_status=$?
            if [ -n "$__vx_at_prompt" ] && [ -z "$COMP_LINE" ]; then
                __vx_at_prompt=
                printf '\e]133;C\a'
            fi
            return "$__vx_status"
        }
        trap '__vx_preexec' DEBUG
    fi
fi
